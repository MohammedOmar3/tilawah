{"surah":1,"source":"tanzil-uthmani-hafs","ayahs":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"},{"n":2,"text":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"},{"n":3,"text":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"},{"n":4,"text":"مَـٰلِكِ يَوْمِ ٱلدِّينِ"},{"n":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"},{"n":6,"text":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"},{"n":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ"}]}