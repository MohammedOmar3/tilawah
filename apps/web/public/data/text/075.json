{"surah":75,"source":"tanzil-uthmani-hafs","ayahs":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ"},{"n":2,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"},{"n":3,"text":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"n":4,"text":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"},{"n":5,"text":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ"},{"n":6,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ"},{"n":7,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ"},{"n":8,"text":"وَخَسَفَ ٱلْقَمَرُ"},{"n":9,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"},{"n":10,"text":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"},{"n":11,"text":"كَلَّا لَا وَزَرَ"},{"n":12,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"},{"n":13,"text":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"n":14,"text":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ"},{"n":15,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"},{"n":16,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"},{"n":17,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"},{"n":18,"text":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"},{"n":19,"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"},{"n":20,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"},{"n":21,"text":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ"},{"n":22,"text":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ"},{"n":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌ"},{"n":24,"text":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ"},{"n":25,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ"},{"n":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"},{"n":27,"text":"وَقِيلَ مَنْ ۜ رَاقٍ"},{"n":28,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"},{"n":29,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"n":30,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"},{"n":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"n":32,"text":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"n":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"},{"n":34,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"n":35,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"},{"n":36,"text":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى"},{"n":37,"text":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ"},{"n":38,"text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"},{"n":39,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"n":40,"text":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"}]}