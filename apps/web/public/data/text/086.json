{"surah":86,"source":"tanzil-uthmani-hafs","ayahs":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"n":2,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"},{"n":3,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ"},{"n":4,"text":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},{"n":5,"text":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ"},{"n":6,"text":"خُلِقَ مِن مَّآءٍ دَافِقٍ"},{"n":7,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"},{"n":8,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"},{"n":9,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"},{"n":10,"text":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"},{"n":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"},{"n":12,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"},{"n":13,"text":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ"},{"n":14,"text":"وَمَا هُوَ بِٱلْهَزْلِ"},{"n":15,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"n":16,"text":"وَأَكِيدُ كَيْدًا"},{"n":17,"text":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"}]}