{"surah":96,"source":"tanzil-uthmani-hafs","ayahs":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"},{"n":2,"text":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ"},{"n":3,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"},{"n":4,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"},{"n":5,"text":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ"},{"n":6,"text":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ"},{"n":7,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"},{"n":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"},{"n":9,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"},{"n":10,"text":"عَبْدًا إِذَا صَلَّىٰٓ"},{"n":11,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"},{"n":12,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"},{"n":13,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"},{"n":14,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"n":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"},{"n":16,"text":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ"},{"n":17,"text":"فَلْيَدْعُ نَادِيَهُۥ"},{"n":18,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ"},{"n":19,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩"}]}