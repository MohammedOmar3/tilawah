{"surah":114,"source":"tanzil-uthmani-hafs","ayahs":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"},{"n":2,"text":"مَلِكِ ٱلنَّاسِ"},{"n":3,"text":"إِلَـٰهِ ٱلنَّاسِ"},{"n":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"},{"n":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"},{"n":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"}]}